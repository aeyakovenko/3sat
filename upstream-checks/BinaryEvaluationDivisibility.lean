import Mathlib.FieldTheory.Minpoly.Field
import Mathlib.Algebra.Field.ZMod

/-! Mathlib at d13f23b723b8a846827a245b89c10fc7d3f11612, Lean 4.34.1. -/

namespace BinaryEvaluationDivisibility

open Polynomial GCDMonoid

variable {K : Type*} [Field K] [Algebra (ZMod 2) K]

/-- LCM of the binary minimal polynomials, including the empty LCM. -/
noncomputable def generator : List K → (ZMod 2)[X]
  | [] => 1
  | a :: tail => lcm (minpoly (ZMod 2) a) (generator tail)

/-- Evaluation on every tuple entry vanishes exactly on the principal ideal
    generated by the LCM. No distinctness assumption on the tuple is needed. -/
theorem vanishes_iff_dvd (points : List K) (p : (ZMod 2)[X]) :
    (∀ a ∈ points, aeval a p = 0) ↔ generator points ∣ p := by
  induction points with
  | nil => simp [generator]
  | cons a tail ih =>
    rw [List.forall_mem_cons, generator, lcm_dvd_iff, minpoly.dvd_iff, ← ih]

theorem identical_evaluations_iff (points : List K) (p q : (ZMod 2)[X]) :
    (∀ a ∈ points, aeval a p = aeval a q) ↔ generator points ∣ p - q := by
  simpa only [map_sub, sub_eq_zero] using vanishes_iff_dvd points (p-q)

theorem generator_ne_zero (points : List K)
    (integral : ∀ a ∈ points, IsIntegral (ZMod 2) a) : generator points ≠ 0 := by
  induction points with
  | nil => simp [generator]
  | cons a tail ih =>
    exact lcm_ne_zero_iff.mpr ⟨minpoly.ne_zero (integral a (by simp)),
      ih (fun b hb => integral b (List.mem_cons_of_mem _ hb))⟩

/-- For polynomial length T, each nonzero kernel element has a quotient
    of degree strictly below T minus the LCM degree. Zero is always included. -/
theorem bounded_kernel (points : List K) (T : ℕ) (p : (ZMod 2)[X])
    (integral : ∀ a ∈ points, IsIntegral (ZMod 2) a) :
    (p.degree < (T : WithBot ℕ) ∧ ∀ a ∈ points, aeval a p = 0) ↔
      p = 0 ∨ ∃ s : (ZMod 2)[X], s ≠ 0 ∧ p = generator points * s ∧
        s.natDegree < T - (generator points).natDegree := by
  have nonzero := generator_ne_zero points integral
  constructor
  · rintro ⟨deg, vanishes⟩
    by_cases hp : p = 0
    · exact Or.inl hp
    · obtain ⟨s, hs⟩ := (vanishes_iff_dvd points p).mp vanishes
      have snz : s ≠ 0 := by
        intro e
        simp [e] at hs
        exact hp hs
      refine Or.inr ⟨s, snz, hs, ?_⟩
      rw [degree_eq_natDegree hp] at deg
      have small : p.natDegree < T := by exact_mod_cast deg
      rw [hs, natDegree_mul nonzero snz] at small
      omega
  · rintro (rfl | ⟨s, snz, rfl, small⟩)
    · simp
    · refine ⟨?_, (vanishes_iff_dvd ..).mpr ⟨s, rfl⟩⟩
      rw [degree_eq_natDegree (mul_ne_zero nonzero snz), natDegree_mul nonzero snz]
      exact_mod_cast (show (generator points).natDegree + s.natDegree < T by omega)

/-- At a fixed tuple of integral points the first undetectable nonzero
    polynomial is the generator itself. The inequality is exact, including T=0. -/
theorem detects_all_iff (points : List K) (T : ℕ)
    (integral : ∀ a ∈ points, IsIntegral (ZMod 2) a) :
    (∀ p : (ZMod 2)[X], p.degree < (T : WithBot ℕ) →
      (∀ a ∈ points, aeval a p = 0) → p = 0) ↔ T ≤ (generator points).natDegree := by
  have hn := generator_ne_zero points integral
  constructor
  · intro detects
    by_contra! small
    have deg : (generator points).degree < (T : WithBot ℕ) := by
      rw [degree_eq_natDegree hn]
      exact_mod_cast small
    exact hn (detects _ deg ((vanishes_iff_dvd ..).mpr dvd_rfl))
  · intro limit p deg hp
    rcases (bounded_kernel points T p integral).mp ⟨deg, hp⟩ with zero | ⟨_, _, _, small⟩
    · exact zero
    · omega

/-- In a finite extension of the binary field every challenge is integral. -/
theorem finite_field_cutoff [Finite K] (points : List K) (T : ℕ) :
    (∀ p : (ZMod 2)[X], p.degree < (T : WithBot ℕ) →
      (∀ a ∈ points, aeval a p = 0) → p = 0) ↔ T ≤ (generator points).natDegree :=
  detects_all_iff points T (fun a _ => Algebra.IsIntegral.isIntegral a)

end BinaryEvaluationDivisibility

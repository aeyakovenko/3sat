import Std

namespace TranslatedTraceGaps

structure Word where
  first : Int
  rest : List Int

def gaps (a : Int) : List Int → List Int
  | [] => []
  | x :: xs => (x - a) :: gaps x xs

def lastAfter (a : Int) : List Int → Int
  | [] => a
  | x :: xs => lastAfter x xs

def translate (s : Word) (u : Int) : Word :=
  ⟨s.first + u, s.rest.map (· + u)⟩

def join (s t : Word) : Word := ⟨s.first, s.rest ++ t.first :: t.rest⟩

def bridge (s t : Word) : Int := t.first - lastAfter s.first s.rest

theorem gaps_shift (u a : Int) (l : List Int) :
    gaps (a + u) (l.map (· + u)) = gaps a l := by
  induction l generalizing a with
  | nil => rfl
  | cons x t ih =>
    simp only [List.map_cons, gaps, ih]
    congr 1
    omega

theorem gaps_append (a : Int) (left right : List Int) :
    gaps a (left ++ right) = gaps a left ++ gaps (lastAfter a left) right := by
  induction left generalizing a with
  | nil => rfl
  | cons x t ih => simp [gaps, lastAfter, ih]

theorem gaps_join (s t : Word) :
    gaps (join s t).first (join s t).rest =
      gaps s.first s.rest ++ bridge s t :: gaps t.first t.rest := by
  simp [join, gaps_append, gaps, bridge]

/-- The previously built words may be used on arbitrarily many later edges. -/
inductive Generated : List Word → List Int → Nat → Prop where
  | empty : Generated [] [] 0
  | leaf {ss ds n} (h : Generated ss ds n) (a : Int) :
      Generated (⟨a, []⟩ :: ss) ds n
  | concat {ss ds n} (h : Generated ss ds n) (s t : Word)
      (hs : s ∈ ss) (ht : t ∈ ss) (u v : Int) :
      Generated (join (translate s u) (translate t v) :: ss)
        (bridge (translate s u) (translate t v) :: ds) (n + 1)

/-- One entry per actual concatenation covers all consecutive differences in
every accessible translation of every word generated by the DAG. -/
theorem catalogue {ss ds n} (h : Generated ss ds n) :
    ds.length = n ∧ ∀ s ∈ ss, ∀ z ∈ gaps s.first s.rest, z ∈ ds := by
  induction h with
  | empty => simp
  | leaf h a ih =>
    refine ⟨ih.1, ?_⟩
    intro s hs z hz
    rcases List.mem_cons.mp hs with rfl | prev
    · simp [gaps] at hz
    · exact ih.2 s prev z hz
  | concat h s t hs ht u v ih =>
    refine ⟨by simp [ih.1], ?_⟩
    intro out hout z hz
    rcases List.mem_cons.mp hout with rfl | prev
    · rw [gaps_join] at hz
      rcases List.mem_append.mp hz with left | other
      · simp only [translate, gaps_shift] at left
        exact List.mem_cons_of_mem _ (ih.2 s hs z left)
      · rcases List.mem_cons.mp other with rfl | right
        · exact List.mem_cons_self
        · simp only [translate, gaps_shift] at right
          exact List.mem_cons_of_mem _ (ih.2 t ht z right)
    · exact List.mem_cons_of_mem _ (ih.2 out prev z hz)

end TranslatedTraceGaps

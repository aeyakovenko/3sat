import Std

namespace TwoBitSnapshotPaths

structure Literal (ι : Type) where
  index : ι
  value : Bool

def Literal.holds (l : Literal ι) (bits : ι → Bool) : Prop := bits l.index = l.value

def Literal.flip (l : Literal ι) : Literal ι := ⟨l.index, !l.value⟩

theorem holds_flip (l : Literal ι) (bits : ι → Bool) :
    l.flip.holds bits ↔ ¬ l.holds bits := by
  rcases l with ⟨i, b⟩
  cases b <;> cases h : bits i <;> simp [Literal.holds, Literal.flip, h]

/-- For a fixed address and expected word, `true` means the decoder answers correctly.
    After each advice query the next address can depend on the observed bit. -/
inductive Tree (ι : Type) : Nat → Type where
  | leaf (answer : Bool) : Tree ι d
  | query (index : ι) (next : Bool → Tree ι d) : Tree ι (d+1)

def Tree.run (bits : ι → Bool) : Tree ι d → Bool
  | .leaf answer => answer
  | .query i next => (next (bits i)).run bits

/-- A path also records repeated queries, including inconsistent hypothetical answers. -/
inductive EndsAt : Tree ι d → List (Literal ι) → Bool → Prop where
  | leaf : EndsAt (.leaf answer : Tree ι d) [] answer
  | query (b : Bool) (tail : EndsAt (next b) path answer) :
      EndsAt (.query i next) (⟨i,b⟩ :: path) answer

theorem EndsAt.length_le {t : Tree ι d} (h : EndsAt t path answer) : path.length ≤ d := by
  induction h with
  | leaf => simp
  | query _ _ ih => simpa using Nat.succ_le_succ ih

theorem EndsAt.run_of_matches {t : Tree ι d} (h : EndsAt t path answer) (bits : ι → Bool)
    (matchesPath : ∀ l ∈ path, l.holds bits) : t.run bits = answer := by
  induction h with
  | leaf => rfl
  | @query _ _ _ _ i b _ ih =>
    have first : bits i = b := matchesPath ⟨i,b⟩ (by simp)
    simp only [Tree.run, first]
    exact ih (fun l hl => matchesPath l (List.mem_cons_of_mem _ hl))

/-- Complement each observed answer. The resulting disjunction is exactly the
    condition that the actual answers differ from this path somewhere. -/
def excludes (path : List (Literal ι)) (bits : ι → Bool) : Prop :=
  ∃ l ∈ path.map Literal.flip, l.holds bits

theorem excludes_iff (path : List (Literal ι)) (bits : ι → Bool) :
    excludes path bits ↔ ¬ ∀ l ∈ path, l.holds bits := by
  classical
  constructor
  · rintro ⟨l, mem, holds⟩ all
    obtain ⟨a, ha, rfl⟩ := List.mem_map.mp mem
    exact (holds_flip a bits).1 holds (all a ha)
  · intro notAll
    apply Classical.byContradiction
    intro none
    apply notAll
    intro a ha
    exact Classical.byContradiction (fun miss =>
      none ⟨a.flip, List.mem_map.mpr ⟨a,ha,rfl⟩, (holds_flip a bits).2 miss⟩)

theorem rejecting_clause {t : Tree ι 2} (bad : EndsAt t path false) :
    (path.map Literal.flip).length ≤ 2 ∧ ∀ bits, t.run bits = true → excludes path bits := by
  refine ⟨by simpa using bad.length_le, ?_⟩
  intro bits accepted
  apply (excludes_iff path bits).2
  intro matchesPath
  rw [bad.run_of_matches bits matchesPath] at accepted
  contradiction

theorem Tree.realized_path (t : Tree ι d) (bits : ι → Bool) :
    ∃ path, EndsAt t path (t.run bits) ∧ ∀ l ∈ path, l.holds bits := by
  induction t with
  | leaf => exact ⟨[], .leaf, by simp⟩
  | query i next ih =>
    obtain ⟨path, terminal, matchesPath⟩ := ih (bits i)
    refine ⟨⟨i, bits i⟩ :: path, .query (bits i) terminal, ?_⟩
    intro l hl
    rcases List.mem_cons.mp hl with rfl | hl
    · rfl
    · exact matchesPath l hl

theorem accepts_iff_all_clauses (t : Tree ι 2) (bits : ι → Bool) :
    t.run bits = true ↔ ∀ path, EndsAt t path false → excludes path bits := by
  constructor
  · exact fun h _ bad => (rejecting_clause bad).2 bits h
  · intro all
    cases h : t.run bits with
    | true => rfl
    | false =>
      obtain ⟨path, actual, matchesPath⟩ := t.realized_path bits
      rw [h] at actual
      exact False.elim (((excludes_iff path bits).1 (all path actual)) matchesPath)

/-- The two edges generated by the clause `l ∨ r`. A unit clause can repeat a literal. -/
theorem binary_clause_edges (l r : Literal ι) (bits : ι → Bool)
    (clause : l.holds bits ∨ r.holds bits) :
    (l.flip.holds bits → r.holds bits) ∧ (r.flip.holds bits → l.holds bits) := by
  exact ⟨fun nl => clause.resolve_left ((holds_flip l bits).1 nl),
         fun nr => clause.resolve_right ((holds_flip r bits).1 nr)⟩

inductive Walk (edge : Literal ι → Literal ι → Prop) : Literal ι → Literal ι → Prop where
  | nil (l) : Walk edge l l
  | step : Walk edge l m → edge m r → Walk edge l r

theorem Walk.propagate {edge : Literal ι → Literal ι → Prop} (walk : Walk edge l r) (bits : ι → Bool)
    (satisfied : ∀ a b, edge a b → a.holds bits → b.holds bits) :
    l.holds bits → r.holds bits := by
  induction walk with
  | nil => exact id
  | step _ last ih => exact fun h => satisfied _ _ last (ih h)

theorem opposite_walks_inconsistent {edge : Literal ι → Literal ι → Prop} (forward : Walk edge l l.flip)
    (backward : Walk edge l.flip l) :
    ¬ ∃ bits : ι → Bool, ∀ a b, edge a b → a.holds bits → b.holds bits := by
  rintro ⟨bits, satisfied⟩
  by_cases h : l.holds bits
  · exact (holds_flip l bits).1 (forward.propagate bits satisfied h) h
  · exact h (backward.propagate bits satisfied ((holds_flip l bits).2 h))

end TwoBitSnapshotPaths

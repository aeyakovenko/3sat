import Std

namespace AdaptiveWordOrder

abbrev History (B : Nat) := List (Fin B × Fin B)
abbrev Selector (B : Nat) := History B → Fin B

/-- Histories passed to the selector are newest first. The returned trace
    is in chronological order. -/
def feed {B} (next : Selector B) (past : History B) : List (Fin B) → History B
  | [] => []
  | tag :: tags =>
    let row := (next past, tag)
    row :: feed next (row :: past) tags

/-- Freshness is required only when requesting a new word on this trace. -/
def freshAlong {B} (next : Selector B) (past : History B) : List (Fin B) → Prop
  | [] => True
  | tag :: tags => next past ∉ past.map Prod.fst ∧
      freshAlong next ((next past, tag) :: past) tags

structure Bank (B : Nat) where
  read : Fin B → Fin B
  locate : Fin B → Fin B
  locate_read : ∀ d, locate (read d) = d
  read_locate : ∀ s, read (locate s) = s

private def flip {B} (a b z : Fin B) := if z = a then b else if z = b then a else z

private theorem flip_flip {B} (a b z : Fin B) : flip a b (flip a b z) = z := by
  by_cases hab : a = b
  · subst b
    by_cases h : z = a <;> simp [flip, h]
  · by_cases ha : z = a
    · subst z
      simp [flip, Ne.symm hab]
    · by_cases hb : z = b <;> simp_all [flip]

/-- Make the next slot return its prescribed tag by exchanging two outputs. -/
private def setNext {B} (bank : Bank B) (dest tag : Fin B) : Bank B where
  read d := flip (bank.read dest) tag (bank.read d)
  locate s := bank.locate (flip (bank.read dest) tag s)
  locate_read d := by rw [flip_flip, bank.locate_read]
  read_locate s := by rw [bank.read_locate, flip_flip]

private def fits {B} (p : Bank B) (rows : History B) :=
  ∀ r ∈ rows, p.read r.1 = r.2

private theorem extend {B} (next : Selector B) (tags : List (Fin B)) (past : History B)
    (p : Bank B) (old : fits p past) (fresh : freshAlong next past tags)
    (distinct : tags.Nodup) (unused : ∀ t ∈ tags, t ∉ past.map Prod.snd) :
    ∃ q : Bank B, fits q past ∧ fits q (feed next past tags) := by
  induction tags generalizing past p with
  | nil => exact ⟨p, old, by simp [fits, feed]⟩
  | cons t ts ih =>
    obtain ⟨newDest, later⟩ := fresh
    obtain ⟨newTag, distinctTail⟩ := List.nodup_cons.mp distinct
    let dest := next past
    let row := (dest, t)
    have repair : fits (setNext p dest t) (row :: past) := by
      intro item mem
      rcases List.mem_cons.mp mem with eq | before
      · subst item
        simp [setNext, flip, row]
      · have v := old item before
        have dest_ne : item.1 ≠ dest := by
          intro e
          apply newDest
          change dest ∈ past.map Prod.fst
          rw [← e]
          exact List.mem_map_of_mem before
        have prior_ne : p.read item.1 ≠ p.read dest := by
          intro eq
          exact dest_ne (by simpa [p.locate_read] using congrArg p.locate eq)
        have tag_ne : p.read item.1 ≠ t := by
          rw [v]
          intro eq
          exact unused t (by simp) (eq ▸ List.mem_map_of_mem before)
        simpa [setNext, flip, prior_ne, tag_ne] using v
    have freeTail : ∀ s ∈ ts, s ∉ (row :: past).map Prod.snd := by
      intro s hs h
      rcases List.mem_cons.mp h with eq | inPast
      · change s = t at eq
        exact newTag (eq ▸ hs)
      · exact unused s (by simp [hs]) inPast
    obtain ⟨q, agreed, future⟩ := ih (row :: past) _ repair later distinctTail freeTail
    refine ⟨q, fun item mem => agreed item (by simp [mem]), ?_⟩
    intro item mem
    rcases List.mem_cons.mp mem with eq | tailMem
    · subst item
      exact agreed row (by simp)
    · exact future item tailMem

/-- Query the physical bank. Each address is chosen from the transcript
    generated by actual reads. -/
def run {B} (next : Selector B) (p : Bank B) (past : History B) : Nat → History B
  | 0 => []
  | n+1 =>
    let d := next past
    let row := (d, p.read d)
    row :: run next p (row :: past) n

private theorem replay {B} (next : Selector B) (p : Bank B) (past : History B)
    (tags : List (Fin B)) (h : fits p (feed next past tags)) :
    run next p past tags.length = feed next past tags := by
  induction tags generalizing past with
  | nil => rfl
  | cons t ts ih =>
    have head : p.read (next past) = t := h (next past, t) (by simp [feed])
    have tail : fits p (feed next ((next past, t) :: past) ts) :=
      fun i hi => h i (by simp [feed, hi])
    simpa only [List.length_cons, run, feed, head, List.cons.injEq, true_and] using
      ih ((next past, t) :: past) tail

/-- A prescribed distinct tag listing can be fed without changing the next
    address rule. One immutable physical permutation realizes the whole trace.
    The observations have both single-valued projections. -/
theorem realizes_tag_order {B} (next : Selector B) (tags : List (Fin B))
    (distinct : tags.Nodup) (fresh : freshAlong next [] tags) :
    ∃ p : Bank B, run next p [] tags.length = feed next [] tags ∧
      (∀ d s, (d, s) ∈ feed next [] tags → p.read d = s) ∧
      (∀ d s, (d, s) ∈ feed next [] tags → p.locate s = d) := by
  let identity : Bank B := ⟨id, id, fun _ => rfl, fun _ => rfl⟩
  obtain ⟨p, _, reads⟩ := extend next tags [] identity
    (by simp [fits]) fresh distinct (by simp)
  refine ⟨p, replay next p [] tags reads, fun d s h => reads (d, s) h, ?_⟩
  intro d s h
  rw [← show p.read d = s from reads (d, s) h, p.locate_read]

theorem fed_tags {B} (next : Selector B) (past : History B) (tags : List (Fin B)) :
    (feed next past tags).map Prod.snd = tags := by
  induction tags generalizing past with
  | nil => rfl
  | cons t ts ih => simp [feed, ih]

theorem physical_tag_order {B} (next : Selector B) (tags : List (Fin B))
    (distinct : tags.Nodup) (fresh : freshAlong next [] tags) :
    ∃ p : Bank B, (run next p [] tags.length).map Prod.snd = tags := by
  obtain ⟨p, exactTrace, _, _⟩ := realizes_tag_order next tags distinct fresh
  exact ⟨p, by rw [exactTrace, fed_tags]⟩

end AdaptiveWordOrder
